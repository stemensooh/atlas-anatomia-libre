# Plantilla de configuración del servidor (server/).
# Cópiala como server/.env y rellena los valores. server/.env NO se versiona (.gitignore):
# nunca subas credenciales reales al repositorio. Este archivo solo lleva valores de ejemplo.
# Guía completa: docs/POSTGRESQL.md

# --- Servidor HTTP ---
# Puerto y dirección donde escucha la API (Vite reenvía /api a este puerto en desarrollo).
PORT=3001
HOST=127.0.0.1

# Pon 1 al publicar con HTTPS: la cookie de sesión lleva el atributo Secure.
COOKIE_SECURE=0

# --- Base de datos ---
# Motor: sqlite | postgres. Si no se indica, se usa PostgreSQL cuando hay DATABASE_URL
# y SQLite en otro caso.
DB_CLIENT=postgres

# PostgreSQL. Formato: postgres://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE_DE_DATOS
# - Caracteres especiales en la contraseña (@ : / ? # % &) van codificados: @ → %40, # → %23…
# - Servidor remoto con TLS: añade ?sslmode=require al final.
DATABASE_URL=postgres://atlas_app:cambia-esta-contraseña@127.0.0.1:5432/atlas

# SQLite (solo con DB_CLIENT=sqlite). Por defecto: server/data/atlas.db
# ATLAS_DB=data/atlas.db

# --- Primer administrador (opcional) ---
# Solo para automatizar `pnpm run create-admin -- <usuario>` (p. ej. en CI). Si se deja vacío,
# el script pide la contraseña por teclado sin mostrarla. Bórrala de aquí después de usarla.
ATLAS_ADMIN_PASSWORD=
